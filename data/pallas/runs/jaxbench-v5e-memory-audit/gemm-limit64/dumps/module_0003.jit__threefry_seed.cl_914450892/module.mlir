    %c_0 = stablehlo.constant dense<32> : tensor<i32> loc(#loc)
    %0 = stablehlo.shift_right_logical %arg0, %c_0 : tensor<i32> loc(#loc22)
    %1 = stablehlo.convert %0 : (tensor<i32>) -> tensor<ui32> loc(#loc23)
    %2 = stablehlo.broadcast_in_dim %1, dims = [] : (tensor<ui32>) -> tensor<1xui32> loc(#loc24)
    %3 = stablehlo.and %arg0, %c : tensor<i32> loc(#loc25)
    %4 = stablehlo.convert %3 : (tensor<i32>) -> tensor<ui32> loc(#loc23)
    %5 = stablehlo.broadcast_in_dim %4, dims = [] : (tensor<ui32>) -> tensor<1xui32> loc(#loc24)
    %6 = stablehlo.concatenate %2, %5, dim = 0 : (tensor<1xui32>, tensor<1xui32>) -> tensor<2xui32> loc(#loc26)
    return %6 : tensor<2xui32> loc(#loc)
  } loc(#loc)
} loc(#loc)
